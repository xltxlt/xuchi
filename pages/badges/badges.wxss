.page{min-height:100vh;background:#f8f5ef;padding:35rpx 30rpx}.title{font-size:50rpx;font-weight:800;margin-bottom:25rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.badge{background:#fff;border-radius:24rpx;padding:28rpx;text-align:center;opacity:.45}.badge.on{opacity:1}.badge>text{font-size:60rpx;display:block}.badge b,.badge small,.badge label{display:block}.badge b{margin:12rpx}.badge small{color:#999;min-height:60rpx}.badge label{color:#ff6848;font-size:21rpx;margin-top:12rpx}