.page{min-height:100vh;background:#fff8ef;padding:32rpx 28rpx;box-sizing:border-box;color:#332d29}.head{display:flex;justify-content:space-between;align-items:center;margin-bottom:28rpx}.title{font-size:46rpx;font-weight:800}.sub{font-size:23rpx;color:#9b8f86;margin-top:7rpx}.head>text{font-size:23rpx;color:#ff6848}.item{display:flex;align-items:center;background:#fff;border-radius:22rpx;padding:22rpx 18rpx;margin-bottom:14rpx;box-shadow:0 8rpx 25rpx rgba(80,55,40,.05)}.emoji{width:86rpx;height:86rpx;border-radius:18rpx;background:#fff2df;display:flex;align-items:center;justify-content:center;font-size:48rpx}.main{flex:1;margin-left:18rpx}.name{font-size:28rpx;font-weight:750}.store{font-size:21rpx;color:#958981;margin-top:5rpx}.date{font-size:19rpx;color:#b0a49c;margin-top:6rpx}.status{font-size:21rpx;color:#ff6848}.arrow{font-size:32rpx;color:#b6aaa2;margin-left:10rpx}.empty{text-align:center;padding:180rpx 40rpx;color:#9b8f86}.empty>text{display:block;font-size:80rpx;margin-bottom:24rpx}.empty view{font-size:30rpx;color:#554b45}.empty small{display:block;font-size:21rpx;margin-top:12rpx}