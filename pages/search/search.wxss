.page{padding:24rpx}.searchbar{height:82rpx;background:#fff;border-radius:24rpx;display:flex;align-items:center;padding:0 24rpx;gap:16rpx;box-sizing:border-box}.searchbar input{flex:1}.searchbar text:last-child{color:#ff6848}.title{font-weight:700;margin:36rpx 0 18rpx}.chips{display:flex;flex-wrap:wrap;gap:16rpx}.chips text,.tags text{background:#fff0e8;color:#ff6848;padding:10rpx 18rpx;border-radius:30rpx;font-size:24rpx}.tabs{display:flex;gap:48rpx;margin:36rpx 0 20rpx;border-bottom:1rpx solid #eee}.tabs text{padding-bottom:16rpx;color:#999}.tabs .on{color:#ff6848;border-bottom:4rpx solid #ff6848}.card{background:#fff;border-radius:28rpx;padding:24rpx;margin-bottom:18rpx}.store{display:flex;gap:22rpx}.emoji{font-size:54rpx}.name{font-size:32rpx;font-weight:700}.muted{color:#999;font-size:24rpx;margin-top:8rpx}.tags{display:flex;gap:10rpx;margin-top:12rpx}.empty{text-align:center;color:#999;padding:100rpx 0}