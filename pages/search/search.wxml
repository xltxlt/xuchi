<view class="page"><view class="searchbar"><text>🔍</text><input value="{{keyword}}" placeholder="搜菜品、店铺、口味" bindinput="onInput" confirm-type="search" bindconfirm="search"/><text bindtap="search">搜索</text></view><view class="hot" wx:if="{{!keyword}}"><view class="title">大家都在搜</view><view class="chips"><text wx:for="{{hot}}" wx:key="*this" bindtap="hotSearch" data-k="{{item}}">{{item}}</text></view></view><view class="tabs"><text class="{{tab==='dish'?'on':''}}" data-tab="dish" bindtap="setTab">菜品</text><text class="{{tab==='store'?'on':''}}" data-tab="store" bindtap="setTab">店铺</text></view><view wx:if="{{tab==='dish'}}"><dish-card wx:for="{{results}}" wx:key="id" dish="{{item}}"/></view><view wx:else><view class="store card" wx:for="{{results}}" wx:key="id" data-id="{{item.id}}" bindtap="openStore"><text class="emoji">{{item.emoji}}</text><view><view class="name">{{item.name}}</view><view class="muted">{{item.distance}} · {{item.match}}%适合你</view><view class="tags"><text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view></view></view></view><view class="empty" wx:if="{{keyword && !results.length}}">没有找到“{{keyword}}”<view>换个口味试试？</view></view></view>