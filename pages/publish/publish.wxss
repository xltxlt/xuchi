.page{min-height:100vh;background:#f8f5ef;padding:40rpx 30rpx 60rpx;color:#27231f}.title{font-size:54rpx;font-weight:800}.sub{color:#99918a;margin:12rpx 0 28rpx}.photo{height:300rpx;background:#fff;border-radius:28rpx;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#aaa19a;margin-bottom:22rpx;overflow:hidden}.photo image{width:100%;height:100%}.page>input{background:#fff;border-radius:18rpx;padding:22rpx;margin-bottom:16rpx;box-sizing:border-box}.label{font-size:28rpx;font-weight:800;margin:28rpx 0 14rpx}.tags{display:flex;flex-wrap:wrap;gap:14rpx}.tag{background:#fff;padding:12rpx 20rpx;border-radius:30rpx;color:#777}.tag.on{background:#fff0ea;color:#ff6848}.status{display:flex;gap:12rpx}.status button{flex:1;font-size:23rpx}.current{text-align:center;color:#ff6848;margin:18rpx}.submit{background:#ff6848;color:#fff;border-radius:50rpx}