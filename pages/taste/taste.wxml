<view class="page"><view class="title">我的口味</view><view class="sub">选得越准，许吃越懂你</view><view class="chips"><text wx:for="{{selected}}" wx:key="*this" class="chip on">{{item}}</text></view><view class="all"><text wx:for="{{options}}" wx:key="*this" class="chip {{selected.indexOf(item)>=0?'on':''}}" data-tag="{{item}}" bindtap="toggle">{{item}}</text></view><button class="save" bindtap="save">保存口味</button></view>