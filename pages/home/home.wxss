.page{min-height:100vh;background:#fff8ef;padding:24rpx 28rpx 80rpx;box-sizing:border-box;color:#332d29}.hero{padding:20rpx 8rpx 30rpx}.hello{font-size:26rpx;color:#8d8178}.title{font-size:48rpx;font-weight:800;line-height:1.25;margin-top:12rpx}.subtitle{font-size:27rpx;color:#81766e;margin-top:8rpx}.taste-link{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;background:#fff1df;border-radius:18rpx;padding:18rpx 20rpx;color:#6f5a4d;font-size:25rpx}.taste-link text{color:#ff6848;font-size:23rpx}.decision{display:flex;align-items:center;gap:16rpx;background:#ff6848;border-radius:24rpx;padding:24rpx 20rpx;margin-bottom:28rpx;box-shadow:0 10rpx 28rpx rgba(255,104,72,.18)}.decision-icon{font-size:44rpx}.decision-main{flex:1}.decision-title{font-size:30rpx;font-weight:800;color:#fff}.decision-sub{font-size:21rpx;color:#fff2ed;margin-top:6rpx;line-height:1.45}.decision-arrow{font-size:22rpx;color:#fff;font-weight:700;white-space:nowrap}.section-head{display:flex;justify-content:space-between;align-items:center;margin:18rpx 4rpx}.section-title{font-size:34rpx;font-weight:800}.section-desc{font-size:22rpx;color:#9a8e86}.shuffle,.more{color:#ff6848;font-size:24rpx}.pick-card{display:flex;align-items:center;background:#fff;border-radius:24rpx;padding:22rpx;margin-bottom:18rpx;box-shadow:0 8rpx 28rpx rgba(89,60,40,.06)}.food{width:112rpx;height:112rpx;border-radius:22rpx;background:#fff2df;display:flex;align-items:center;justify-content:center;font-size:62rpx;flex:none}.pick-main{flex:1;margin-left:20rpx;min-width:0}.row{display:flex;justify-content:space-between;align-items:center}.dish-name{font-size:30rpx;font-weight:750}.price{color:#ff6848;font-weight:800;font-size:29rpx}.store{font-size:22rpx;color:#988b82;margin-top:6rpx}.tags{display:flex;gap:8rpx;margin-top:10rpx;overflow:hidden;white-space:nowrap}.tag{background:#f8f3ed;color:#776b63;padding:5rpx 10rpx;border-radius:10rpx;font-size:19rpx}.reason{font-size:21rpx;color:#e86b48;margin-top:9rpx}.match{width:78rpx;text-align:center;color:#ff6848;font-weight:800;font-size:27rpx}.match text{display:block;font-size:17rpx;font-weight:400;color:#a09289;margin-top:2rpx}.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin:24rpx 0}.quick{display:flex;align-items:center;background:#fff;border-radius:20rpx;padding:22rpx 18rpx}.quick>text{font-size:40rpx;margin-right:14rpx}.quick b{display:block;font-size:25rpx}.quick small{display:block;color:#a09289;font-size:19rpx;margin-top:5rpx}.history-block{margin-top:12rpx}.recent{display:flex;align-items:center;background:#fff;border-radius:18rpx;padding:17rpx 18rpx;margin-bottom:10rpx}.recent-emoji{font-size:42rpx;width:64rpx}.recent-main{flex:1}.recent-main b{display:block;font-size:25rpx}.recent-main text{display:block;color:#9a8e86;font-size:19rpx;margin-top:4rpx}.recent-status{font-size:21rpx;color:#ff6848}.bottom-tip{text-align:center;color:#b1a59d;font-size:20rpx;padding:28rpx 0}.history-block .section-head{margin-top:34rpx}
.error-card{margin:0 0 24rpx;padding:22rpx;background:#fff;border-radius:22rpx;text-align:center;color:#5d5149}.error-card view{font-size:28rpx;font-weight:800}.error-card text{display:block;margin:8rpx 0 16rpx;color:#9a8e86;font-size:21rpx}.error-card button{display:inline-block;width:180rpx;height:64rpx;line-height:64rpx;background:#ff6848;color:#fff;border-radius:999rpx;font-size:23rpx}.loading-list{margin-bottom:18rpx}.skeleton-card{height:156rpx;margin-bottom:18rpx;padding:22rpx;box-sizing:border-box;background:#fff;border-radius:24rpx;display:flex}.skeleton-food{width:112rpx;height:112rpx;border-radius:22rpx;background:#f3eee8}.skeleton-main{flex:1;margin-left:20rpx;padding-top:10rpx}.skeleton-line{height:20rpx;width:65%;margin-bottom:16rpx;border-radius:10rpx;background:#f3eee8}.skeleton-line.long{width:82%}.skeleton-line.short{width:42%}

.vote-row{display:flex;gap:10rpx;margin-top:12rpx}.vote-btn{margin:0;padding:0 18rpx;height:52rpx;line-height:52rpx;border:1rpx solid #eee4da;border-radius:999rpx;background:#fffaf5;color:#786d65;font-size:19rpx}.vote-btn::after{border:0}.vote-btn.yes.active{background:#fff0e8;border-color:#ffb09b;color:#ff6848}.vote-btn.no.active{background:#f3f1ef;border-color:#d8d0ca;color:#716860}

.welcome-card{margin:0 0 22rpx;padding:34rpx 28rpx;background:#fff;border-radius:28rpx;text-align:center;box-shadow:0 10rpx 30rpx rgba(89,60,40,.06)}.welcome-emoji{font-size:58rpx}.welcome-title{font-size:32rpx;font-weight:800;margin-top:8rpx}.welcome-sub{font-size:22rpx;color:#958980;margin:8rpx 0 20rpx}.welcome-card button{width:420rpx;max-width:100%;height:76rpx;line-height:76rpx;background:#ff6848;color:#fff;border-radius:999rpx;font-size:25rpx}.welcome-card button::after{border:0}.welcome-skip{font-size:20rpx;color:#aaa19b;margin-top:14rpx}

.decision-hover{transform:scale(.985);opacity:.94}.quick{min-height:92rpx}.quick-arrow{margin-left:auto!important;margin-right:0!important;font-size:34rpx!important;color:#c2b7af}.shuffle{padding:12rpx 8rpx}.pick-card{min-height:156rpx}.vote-btn{min-width:132rpx}.match{font-size:29rpx}

.preference-strip{background:#fff;border-radius:20rpx;padding:16rpx 16rpx 14rpx;margin:-8rpx 0 22rpx;box-shadow:0 6rpx 22rpx rgba(89,60,40,.04)}.pref-title{display:block;font-size:21rpx;color:#81766e;margin-bottom:10rpx;font-weight:700}.pref-scroll{white-space:nowrap}.pref-item{display:inline-block;padding:11rpx 18rpx;margin-right:10rpx;border-radius:999rpx;background:#faf5ef;color:#6f6259;font-size:21rpx}.pref-item:active{background:#fff0e5;color:#ff6848}
