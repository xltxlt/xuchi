.page{min-height:100vh;background:#f8f5ef;padding:34rpx 30rpx;color:#27231f}.profile{text-align:center;background:#fff;border-radius:30rpx;padding:42rpx}.avatar{font-size:76rpx}.name{font-size:42rpx;font-weight:800;margin:12rpx}.level{color:#ff6848}.tags{display:flex;justify-content:center;flex-wrap:wrap;gap:10rpx;margin-top:16rpx}.tags text{background:#fff0ea;color:#ff6848;padding:7rpx 14rpx;border-radius:15rpx;font-size:21rpx}.stats{display:flex;background:#fff;border-radius:25rpx;margin:20rpx 0;padding:25rpx 0}.stats view{flex:1;text-align:center}.stats b,.stats small{display:block}.stats b{font-size:34rpx}.stats small{color:#999;margin-top:5rpx}.menu{background:#fff;border-radius:25rpx;overflow:hidden}.menu view{padding:30rpx;border-bottom:1px solid #f3eee8;font-size:28rpx}.menu text{float:right;color:#aaa}