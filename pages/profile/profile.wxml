<view class="page"><view class="profile"><text class="avatar">{{user.avatar||'🍜'}}</text><view class="name">{{user.name||'小许'}}</view><view class="level">Lv.{{user.level||1}} {{user.levelName||'初来乍吃'}}</view><view class="tags"><text wx:for="{{user.tags}}" wx:key="*this">{{item}}</text></view></view><view class="stats"><view><b>{{user.eatCount||0}}</b><small>吃过</small></view><view><b>{{user.likeCount||0}}</b><small>许吃</small></view><view><b>{{user.match||0}}%</b><small>口味匹配</small></view></view><view class="menu"><view bindtap="openTaste">🌶️ 我的口味画像 <text>›</text></view><view bindtap="openHobby">👯 我的同好 <text>›</text></view><view bindtap="openHistory">🍽️ 吃过的美食 <text>›</text></view><view bindtap="openLike">❤️ 我的许吃 <text>›</text></view><view bindtap="openBadges">🏅 我的勋章 <text>›</text></view></view></view>