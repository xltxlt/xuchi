.page{min-height:100vh;background:#fffaf4;padding:30rpx 28rpx 70rpx;box-sizing:border-box;color:#29231f}.hero{padding:12rpx 4rpx 24rpx}.hero-top{display:flex;align-items:flex-start;justify-content:space-between}.eyebrow{font-size:23rpx;color:#ff6848;margin-bottom:8rpx;font-weight:600}.title{font-size:52rpx;line-height:1.15;font-weight:800;letter-spacing:-2rpx}.sub{font-size:25rpx;color:#8c8279;margin-top:14rpx}.loc{font-size:22rpx;color:#ff6848;background:#fff0e9;padding:13rpx 18rpx;border-radius:30rpx;margin-top:6rpx}.scene-scroll{white-space:nowrap;margin:4rpx -28rpx 20rpx;padding-left:28rpx;width:calc(100% + 56rpx)}.scene{display:inline-block;padding:15rpx 26rpx;margin-right:12rpx;border-radius:30rpx;background:#f3eee8;color:#766e67;font-size:25rpx}.scene.active{background:#ff6848;color:#fff;font-weight:700}.hint{display:flex;align-items:center;background:#fff3df;border-radius:20rpx;padding:22rpx;margin-bottom:28rpx}.hint-icon{width:46rpx;height:46rpx;border-radius:50%;background:#ffdfb0;color:#d97832;text-align:center;line-height:46rpx;margin-right:16rpx}.hint b{display:block;font-size:26rpx}.hint small{display:block;color:#9b8c7f;font-size:21rpx;margin-top:5rpx}.section-title{font-size:32rpx;font-weight:800;margin:20rpx 2rpx}.store-card{background:#fff;border-radius:26rpx;padding:24rpx;margin-bottom:20rpx;box-shadow:0 8rpx 28rpx rgba(73,48,27,.06)}.store-head{display:flex;align-items:center}.store-icon{width:76rpx;height:76rpx;border-radius:22rpx;background:#fff1e8;display:flex;align-items:center;justify-content:center;font-size:42rpx;margin-right:18rpx}.store-info{flex:1;min-width:0}.store-name{font-size:30rpx;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.meta{display:flex;align-items:center;color:#9a9088;font-size:21rpx;margin-top:7rpx}.dot{margin:0 9rpx}.open{color:#45a56b}.open.closed{color:#aaa}.match{text-align:right}.match b{display:block;color:#ff6848;font-size:32rpx}.match small{font-size:19rpx;color:#a29a93}.recommend-dish{display:flex;align-items:center;background:#faf7f3;border-radius:20rpx;padding:16rpx;margin-top:20rpx}.dish-emoji{width:62rpx;height:62rpx;border-radius:16rpx;background:#fff;display:flex;align-items:center;justify-content:center;font-size:32rpx;margin-right:14rpx}.dish-info{flex:1;min-width:0}.dish-name{font-size:27rpx;font-weight:700}.dish-tags{display:flex;gap:10rpx;margin-top:7rpx;white-space:nowrap;overflow:hidden}.dish-tags text{font-size:19rpx;color:#8e857d}.price{font-size:25rpx;font-weight:700;margin-left:8rpx}.arrow{font-size:34rpx;color:#b6aaa0;margin-left:8rpx}.store-foot{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx}.tags{display:flex;gap:8rpx;flex:1;overflow:hidden;white-space:nowrap}.tag{font-size:19rpx;color:#8c6e5d;background:#fff3ed;border-radius:8rpx;padding:6rpx 10rpx}.why{font-size:21rpx;color:#ff6848;margin-left:14rpx;white-space:nowrap}.loading,.empty{text-align:center;color:#9b9189;font-size:23rpx;padding:50rpx 0}.empty{line-height:1.7}