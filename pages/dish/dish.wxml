<view class="container">
  <view class="dish-hero">{{dish.emoji}}</view>
  <view class="detail card">
    <view class="between"><view><view class="dish-name">{{dish.name}}</view><view class="store" bindtap="openStore">{{dish.store}} ›</view></view><view class="price">¥{{dish.price}}</view></view>
    <view class="match-box" bindtap="openReason"><text class="match-big">{{dish.match}}%</text><view><text class="bold">与你口味高度匹配</text><view class="muted">你喜欢的咸香、肉食、夜宵都命中啦</view></view></view>
    <view class="tags"><text wx:for="{{dish.tags}}" wx:key="*this" class="pill">{{item}}</text></view>
    <view class="desc">{{dish.desc}}</view>
    <view class="groupbuy-entry" bindtap="startGroupBuy"><view class="groupbuy-icon">🛒</view><view class="groupbuy-copy"><view class="groupbuy-title">一键发起团购</view><view class="groupbuy-sub">自动带入 {{dish.name}} · ¥{{dish.price}}/{{dish.unit||'份'}}</view></view><text class="groupbuy-arrow">›</text></view>
    <view class="section-title">大家怎么说</view>
    <view class="vote-stat"><view>❤️ 许吃 <b>94%</b></view><view>🤔 有条件 <b>4%</b></view><view>👎 不许吃 <b>2%</b></view></view>
    <view class="section-title">💬 评论</view><view wx:for="{{comments}}" wx:key="_id" class="comment card"><view class="comment-head"><b>{{item.name||'匿名吃货'}}</b><text class="muted">{{item.likes||0}} 赞</text></view><view class="comment-text">{{item.content}}</view><view class="comment-actions"><text bindtap="likeComment" data-id="{{item._id}}">👍 赞</text><text bindtap="reply" data-id="{{item._id}}">↩ 回复</text></view></view><view class="comment-box"><input value="{{comment}}" bindinput="onComment" placeholder="{{replyTo?'回复这位吃货…':'说说你吃过的感受…'}}"/><button bindtap="submitComment">发送</button></view><view class="section-title">和你口味相似的人</view>
    <view class="friend-row"><text class="avatar">👩🏻</text><view><b>小美</b><view class="muted">与你相似度 96%</view></view><text class="orange">她也许吃了 ❤️</text></view>
  </view>
  <view class="bottom-bar"><button bindtap="toggleLike">{{liked?"❤️ 已许吃":"🤍 许吃"}}</button><button class="primary" bindtap="share">分享给同好</button></view>
</view>