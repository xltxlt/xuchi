<view class="container">
  <view class="dish-hero">{{dish.emoji}}</view>
  <view class="detail card">
    <view class="between">
      <view class="title-wrap"><view class="dish-name">{{dish.name}}</view><view class="store" bindtap="openStore">{{dish.store}} ›</view></view>
      <view class="price">¥{{dish.price}}</view>
    </view>

    <view class="match-box" bindtap="openReason">
      <view class="match-score"><text class="match-big">{{dish.match}}%</text><text class="match-label">口味匹配</text></view>
      <view class="match-copy"><text class="bold">这道菜为什么推荐给你？</text><view class="muted">{{reason}}</view></view><text class="arrow">›</text>
    </view>

    <view class="section-title">🏷️ 这道菜的口味标签</view>
    <view class="tags"><text wx:for="{{dish.tags}}" wx:key="*this" class="pill">{{item}}</text></view>
    <view wx:if="{{reasonTags.length}}" class="hit-tip">🎯 命中你的：<text wx:for="{{reasonTags}}" wx:key="*this">{{item}} </text></view>
    <view class="desc">{{dish.desc||'还没有详细描述，吃过之后告诉大家你的真实感受吧。'}}</view>

    <view class="vote-card">
      <view class="vote-title">你许不许吃？</view>
      <view class="vote-sub">你的选择会影响以后给你的推荐</view>
      <view class="vote-grid">
        <view class="vote-item yes {{vote==='yes'?'selected':''}}" data-type="yes" bindtap="vote"><text class="vote-icon">❤️</text><text class="vote-main">许吃</text><text class="vote-num">{{voteCounts.yes||0}} 人 · {{voteStats.yes||0}}%</text></view>
        <view class="vote-item conditional {{vote==='conditional'?'selected':''}}" data-type="conditional" bindtap="vote"><text class="vote-icon">🤔</text><text class="vote-main">有条件许吃</text><text class="vote-num">{{voteCounts.conditional||0}} 人 · {{voteStats.conditional||0}}%</text></view>
        <view class="vote-item no {{vote==='no'?'selected':''}}" data-type="no" bindtap="vote"><text class="vote-icon">👎</text><text class="vote-main">不许吃</text><text class="vote-num">{{voteCounts.no||0}} 人 · {{voteStats.no||0}}%</text></view>
      </view>
    </view>

    <view class="memory-entry" bindtap="recordEat"><view class="memory-icon">{{recorded?'✅':'🍽️'}}</view><view class="memory-copy"><view class="memory-title">{{recorded?'已经吃过这道菜':'记录我吃过这道菜'}}</view><view class="memory-sub">{{recorded?'已进入你的美食记忆':'吃过之后，推荐会越来越懂你'}}</view></view><text>›</text></view>
    <view wx:if="{{recorded}}" class="eat-again" bindtap="eatAgain"><view><view class="eat-again-title">🔁 想再吃？</view><view class="eat-again-sub">把 {{dish.name}} 记入今天的吃过</view></view><text>再吃一次 ›</text></view>

    <view class="section-title"><text>👯 同好评价</text><text class="section-more">{{similarUsers.length}} 位</text></view>
    <view wx:if="{{similarUsers.length}}" class="similar-list">
      <view wx:for="{{similarUsers}}" wx:key="_id" class="similar-row" data-id="{{item._id}}" bindtap="openHobby"><text class="similar-avatar">{{item.avatar||'🍜'}}</text><view class="similar-copy"><view><text class="bold">{{item.name||'美食同好'}}</text><text class="similar-match">与你相似 {{item.similarity||0}}%</text></view><view class="muted">{{item.common&&item.common.length?'共同口味：'+item.common.slice(0,3).join('、'):'口味与你很接近'}}</view></view><text class="orange">{{item.following?'已关注':'同好 ›'}}</text></view>
    </view>
    <view wx:else class="empty-tip">还没有找到相似口味的同好，先留下你的第一条评价吧。</view>

    <view class="section-title"><text>💬 评论聊天</text><text class="section-more">{{comments.length}} 条 · 说说你的真实感受</text></view>
    <view wx:for="{{comments}}" wx:key="_id" class="comment card">
      <view class="comment-head"><view class="comment-user"><text class="comment-avatar">{{item.avatar||'🍜'}}</text><view><text class="bold">{{item.name||'匿名吃货'}}</text><text class="comment-vote">{{item.vote==='yes'?'❤️ 许吃':item.vote==='conditional'?'🤔 有条件':'美食分享'}}</text></view></view><text class="muted">{{item.likes||0}} 赞</text></view>
      <view class="comment-text">{{item.content}}</view>
      <view class="comment-actions"><text bindtap="likeComment" data-id="{{item._id}}">👍 赞</text><text bindtap="reply" data-id="{{item._id}}" data-name="{{item.name||'这位吃货'}}">↩ 回复</text></view>
      <view wx:for="{{item.replies}}" wx:key="_id" class="reply"><view class="comment-head"><view class="comment-user"><text class="reply-avatar">{{item.avatar||'🍜'}}</text><text class="bold">{{item.name||'匿名吃货'}}</text></view><text class="muted">{{item.likes||0}} 赞</text></view><view class="reply-text">{{item.content}}</view></view>
    </view>
    <view wx:if="{{replyTo}}" class="replying">正在回复 {{replyName}} <text bindtap="cancelReply">取消</text></view>
    <view class="comment-box"><input value="{{comment}}" bindinput="onComment" maxlength="200" placeholder="{{replyTo?'回复这位吃货…':'说说你吃过的感受，和同好聊两句…'}}"/><button loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitComment">发送</button></view>

    <view class="quick-links"><view bindtap="favorite">{{favorited?'★ 已收藏':'☆ 收藏这道菜'}}</view><view bindtap="openHistory">🍽️ 我的吃过</view><view bindtap="share">↗ 分享给同好</view></view>
    <view class="groupbuy-entry" bindtap="startGroupBuy"><view class="groupbuy-icon">🛒</view><view class="groupbuy-copy"><view class="groupbuy-title">一键发起团购</view><view class="groupbuy-sub">自动带入 {{dish.name}} · ¥{{dish.price}}/{{dish.unit||'份'}}</view></view><text class="groupbuy-arrow">›</text></view>
  </view>
  <view class="bottom-bar"><button bindtap="vote" data-type="yes">{{vote==='yes'?'❤️ 已许吃':'❤️ 许吃'}}</button><button bindtap="favorite">{{favorited?'★ 已收藏':'☆ 收藏'}}</button><button class="primary" bindtap="recordEat">{{recorded?'🍽️ 再记一次':'🍽️ 吃过'}}</button></view>
</view>