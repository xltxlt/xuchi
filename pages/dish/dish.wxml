<view class="container"><view class="dish-hero">{{dish.emoji}}</view><view class="detail card"><view class="between"><view><view class="dish-name">{{dish.name}}</view><view class="store" bindtap="openStore">{{dish.store}} ›</view></view><view class="price">¥{{dish.price}}</view></view><view class="match-box" bindtap="openReason"><text class="match-big">{{dish.match}}%</text><view><text class="bold">与你口味高度匹配</text><view class="muted">点击查看为什么推荐给你</view></view></view><view class="tags"><text wx:for="{{dish.tags}}" wx:key="*this" class="pill">{{item}}</text></view><view class="desc">{{dish.desc}}</view><view class="memory-entry" bindtap="recordEat"><view class="memory-icon">{{recorded?'✅':'🍽️'}}</view><view class="memory-copy"><view class="memory-title">{{recorded?'已经记过这道菜':'记录这次吃到的味道'}}</view><view class="memory-sub">{{recorded?'去「我的吃过」回顾':'以后推荐会越来越懂你'}}</view></view><text>›</text></view><view wx:if="{{recorded}}" class="eat-again" bindtap="eatAgain"><view><view class="eat-again-title">🔁 想吃了？</view><view class="eat-again-sub">把 {{dish.name}} 加到今天的美食记录</view></view><text>再吃一次 ›</text></view><view class="groupbuy-entry" bindtap="startGroupBuy"><view class="groupbuy-icon">🛒</view><view class="groupbuy-copy"><view class="groupbuy-title">一键发起团购</view><view class="groupbuy-sub">自动带入 {{dish.name}} · ¥{{dish.price}}/{{dish.unit||'份'}}</view></view><text class="groupbuy-arrow">›</text></view><view class="section-title">大家怎么说</view><view class="vote-stat"><view class="vote {{vote==='yes'?'selected':''}}" data-type="yes" bindtap="vote">❤️ 许吃 <text class="vote-percent">{{voteStats.yes}}%</text></view><view class="vote {{vote==='conditional'?'selected':''}}" data-type="conditional" bindtap="vote">🤔 有条件 <text class="vote-percent">{{voteStats.conditional}}%</text></view><view class="vote {{vote==='no'?'selected':''}}" data-type="no" bindtap="vote">👎 不许吃 <text class="vote-percent">{{voteStats.no}}%</text></view></view><view class="section-title">💬 评论</view><view wx:for="{{comments}}" wx:key="_id" class="comment card"><view class="comment-head"><view class="comment-user"><text class="comment-avatar">{{item.avatar||'🍜'}}</text><text class="bold">{{item.name||'匿名吃货'}}</text></view><text class="muted">{{item.likes||0}} 赞</text></view><view class="comment-text">{{item.content}}</view><view class="comment-actions"><text bindtap="likeComment" data-id="{{item._id}}">👍 赞</text><text bindtap="reply" data-id="{{item._id}}" data-name="{{item.name||'这位吃货'}}">↩ 回复</text></view><view wx:for="{{item.replies}}" wx:key="_id" class="reply"><view class="comment-head"><view class="comment-user"><text class="reply-avatar">{{item.avatar||'🍜'}}</text><text class="bold">{{item.name||'匿名吃货'}}</text></view><text class="muted">{{item.likes||0}} 赞</text></view><view class="reply-text">{{item.content}}</view></view></view><view wx:if="{{replyTo}}" class="replying">正在回复 {{replyName}} <text bindtap="cancelReply">取消</text></view><view class="comment-box"><input value="{{comment}}" bindinput="onComment" placeholder="{{replyTo?'回复这位吃货…':'说说你吃过的感受…'}}"/><button bindtap="submitComment">发送</button></view><view class="section-title">和你口味相似的人</view><view class="friend-row"><text class="avatar">👩🏻</text><view><text class="bold">小美</text><view class="muted">与你相似度 96%</view></view><text class="orange">她也许吃了 ❤️</text></view></view><view class="bottom-bar"><button bindtap="vote" data-type="yes">{{vote==='yes'?"❤️ 已许吃":"🤍 许吃"}}</button><button bindtap="favorite">{{favorited?'★ 已收藏':'☆ 收藏'}}</button><button class="primary" bindtap="share">分享给同好</button></view></view>