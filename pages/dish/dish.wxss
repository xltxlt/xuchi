.container{min-height:100vh;background:#FFF8EF;padding-bottom:150rpx}.dish-hero{height:300rpx;background:#FFE6D8;display:flex;align-items:center;justify-content:center;font-size:150rpx}.card{background:#FFFDF9;border-radius:28rpx;box-shadow:0 10rpx 32rpx rgba(85,57,35,.06)}.detail{margin:-28rpx 24rpx 24rpx;padding:28rpx;position:relative}.between{display:flex;justify-content:space-between;align-items:flex-start}.dish-name{font-size:40rpx;font-weight:800;color:#302923}.store{font-size:25rpx;color:#FF6848;margin-top:8rpx}.price{font-size:34rpx;font-weight:800;color:#FF6848}.match-box{display:flex;align-items:center;gap:18rpx;background:#FFF2E8;border-radius:22rpx;padding:20rpx;margin-top:24rpx}.match-big{font-size:44rpx;font-weight:900;color:#FF6848}.bold{font-weight:700;color:#40362F}.muted{font-size:23rpx;color:#9A9088;margin-top:6rpx}.tags{display:flex;flex-wrap:wrap;gap:12rpx;margin:20rpx 0}.pill{padding:8rpx 16rpx;border-radius:999rpx;background:#FFF0E5;color:#9A5B47;font-size:22rpx}.desc{color:#675D55;font-size:26rpx;line-height:1.7}.groupbuy-entry{display:flex;align-items:center;padding:22rpx;margin:24rpx 0;background:linear-gradient(135deg,#FFF0E5,#FFF9F3);border:2rpx solid #FFE0D0;border-radius:22rpx}.groupbuy-icon{width:68rpx;height:68rpx;border-radius:20rpx;background:#FF6848;color:#fff;display:flex;align-items:center;justify-content:center;font-size:34rpx;margin-right:18rpx}.groupbuy-copy{flex:1}.groupbuy-title{font-size:29rpx;font-weight:800;color:#302923}.groupbuy-sub{font-size:22rpx;color:#9A9088;margin-top:6rpx}.groupbuy-arrow{font-size:44rpx;color:#FF6848}.section-title{font-size:30rpx;font-weight:800;color:#302923;margin:30rpx 0 18rpx}.vote-stat{display:flex;justify-content:space-between;font-size:23rpx;color:#766C64}.comment{padding:22rpx;margin-bottom:14rpx}.comment-head{display:flex;justify-content:space-between}.comment-text{margin-top:12rpx;color:#514840;font-size:25rpx;line-height:1.6}.comment-actions{display:flex;gap:28rpx;margin-top:12rpx;color:#9A9088;font-size:22rpx}.comment-box{display:flex;gap:12rpx}.comment-box input{flex:1;background:#F8F3ED;border-radius:999rpx;padding:0 22rpx;height:76rpx}.comment-box button{width:110rpx;background:#FF6848;color:#fff;border-radius:999rpx}.friend-row{display:flex;align-items:center;gap:14rpx;padding:20rpx 0}.avatar{font-size:46rpx}.orange{margin-left:auto;color:#FF6848;font-size:22rpx}.bottom-bar{position:fixed;left:0;right:0;bottom:0;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:rgba(255,253,249,.96);display:flex;gap:16rpx;z-index:10}.bottom-bar button{flex:1;border-radius:999rpx}.bottom-bar .primary{background:#FF6848;color:#fff}button::after{border:0}