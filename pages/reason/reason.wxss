.page{padding:32rpx;background:#fff8ef;min-height:100vh;box-sizing:border-box}.hero{padding:24rpx 8rpx 30rpx}.score{font-size:96rpx;line-height:1;font-weight:900;color:#ff6848}.score text{font-size:34rpx;margin-left:4rpx}.title{font-size:40rpx;font-weight:800;margin:18rpx 0 8rpx}.dish{color:#777;font-size:28rpx}.box{background:#fff;border-radius:28rpx;padding:30rpx;margin-bottom:20rpx;box-shadow:0 8rpx 30rpx rgba(70,40,20,.04)}.h{font-size:30rpx;font-weight:800;margin-bottom:14rpx}.tag{display:inline-block;background:#fff0e8;color:#ff6848;padding:10rpx 18rpx;border-radius:20rpx;margin:8rpx 10rpx 0 0}.soft{background:#f7f3ee;color:#655f59}.reason{margin-top:24rpx;font-size:29rpx;line-height:1.75;color:#3f3a35}.muted{color:#999;font-size:26rpx;line-height:1.6}.proof{display:flex;gap:14rpx;align-items:flex-start;font-size:27rpx;line-height:1.55;color:#4d4741;padding:12rpx 0}.proof-dot{width:34rpx;height:34rpx;line-height:34rpx;text-align:center;border-radius:50%;background:#fff0e8;color:#ff6848;font-weight:800;flex:none}