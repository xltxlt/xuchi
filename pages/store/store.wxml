<view class="page"><view class="hero"><text class="emoji">{{store.emoji||'🍜'}}</text><view class="name">{{store.name}}</view><view class="meta">{{store.distance}} · {{store.match}}%适合你</view><view class="tags"><text wx:for="{{store.tags}}" wx:key="*this">{{item}}</text></view></view><view class="title">店里值得吃</view><view wx:for="{{dishes}}" wx:key="id" class="dish" data-id="{{item.id}}" bindtap="openDish"><text>{{item.emoji}}</text><view><b>{{item.name}}</b><small>¥{{item.price}} · {{item.match}}%匹配</small><view class="tags"><text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view></view></view></view>