<view class="page"><view class="title">我的许吃 ❤️</view><view wx:for="{{list}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><text class="emoji">{{item.emoji}}</text><view><b>{{item.name}}</b><small>{{item.store}} · {{item.match}}%匹配</small><view class="tags"><text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view></view></view><view wx:if="{{!list.length}}" class="empty">还没有许吃过的菜，去首页挑一道吧～</view></view>