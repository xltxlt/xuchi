<view class="page"><view class="hero"><view class="avatar">🍜</view><view><view class="name">{{user.name||'美食同好'}}</view><view class="match">{{user.similarity||0}}% 口味相似</view></view><button size="mini" bindtap="follow">关注</button></view><view class="section"><view class="h">为什么你们很像？</view><view wx:for="{{similarityReasons}}" wx:key="*this" class="reason"><text class="dot">✓</text><text>{{item}}</text></view></view><view class="section"><view class="h">共同喜欢</view><view class="tags"><text wx:for="{{user.common}}" wx:key="*this" class="tag">{{item}}</text></view></view><view wx:if="{{sharedDishes.length}}" class="section"><view class="h">TA也许会和你一起许吃</view><view wx:for="{{sharedDishes}}" wx:key="id" class="dish" data-id="{{item.id}}" bindtap="openDish"><text class="emoji">{{item.emoji||'🍜'}}</text><view><view class="dish-name">{{item.name}}</view><view class="dish-sub">{{item.store||''}}</view></view></view></view><view class="section"><view class="h">TA的口味画像</view><view class="desc">{{(user.taste||[]).join(' · ')}}</view></view></view>