.page{padding:32rpx;background:#fff8ef;min-height:100vh;box-sizing:border-box}.hero,.section{background:#fff;border-radius:28rpx;padding:30rpx;margin-bottom:20rpx}.hero{display:flex;align-items:center;gap:20rpx}.hero .avatar{font-size:70rpx}.name{font-size:38rpx;font-weight:800}.match{color:#ff6848;margin-top:8rpx}.hero button{margin-left:auto}.h{font-size:32rpx;font-weight:800;margin-bottom:14rpx}.desc{color:#777;line-height:1.7}.reason{display:flex;gap:14rpx;color:#4d4741;font-size:28rpx;line-height:1.55;padding:10rpx 0}.dot{width:34rpx;height:34rpx;line-height:34rpx;text-align:center;border-radius:50%;background:#fff0e8;color:#ff6848;font-weight:800;flex:none}.tag{display:inline-block;background:#fff0e8;color:#ff6848;padding:10rpx 18rpx;border-radius:22rpx;margin:8rpx 8rpx 0 0}.dish{display:flex;align-items:center;gap:16rpx;padding:16rpx 0;border-top:1rpx solid #f4eee8}.dish:first-of-type{border-top:0}.emoji{font-size:48rpx}.dish-name{font-size:28rpx;font-weight:700}.dish-sub{font-size:22rpx;color:#999;margin-top:5rpx}