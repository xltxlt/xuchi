.page{padding:32rpx;background:#fff8ef;min-height:100vh;box-sizing:border-box}.title{font-size:42rpx;font-weight:800}.sub{color:#999;margin:12rpx 0 28rpx}.card{background:#fff;padding:26rpx;border-radius:28rpx;margin-bottom:20rpx;display:flex;align-items:center;gap:18rpx;box-shadow:0 8rpx 30rpx rgba(70,40,20,.04)}.avatar{font-size:56rpx}.info{flex:1;min-width:0}.name{font-weight:700;font-size:32rpx}.match{color:#ff6848;font-size:25rpx;margin:8rpx 0}.why{font-size:25rpx;color:#555;margin-bottom:8rpx}.tag{display:inline-block;background:#fff0e8;color:#ff6848;border-radius:20rpx;padding:6rpx 14rpx;margin-right:8rpx;font-size:22rpx}.card button{flex:none}.empty{background:#fff;border-radius:28rpx;padding:50rpx 30rpx;color:#999;text-align:center;font-size:28rpx}