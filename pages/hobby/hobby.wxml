<view class="page"><view class="title">和你口味最像的人</view><view class="sub">一起吃，推荐才会越来越懂你</view><view wx:for="{{users}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="open"><view class="avatar">🍜</view><view class="info"><view class="name">{{item.name||'匿名吃货'}}</view><view class="match">口味相似度 {{item.similarity}}%</view><view class="tags"><text wx:for="{{item.common}}" wx:key="*this" class="tag">{{item}}</text></view></view><button size="mini" catchtap="follow" data-id="{{item._id}}">关注</button></view></view>
