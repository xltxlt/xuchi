.page{min-height:100vh;background:#FFF8EF;padding:32rpx 28rpx 56rpx;box-sizing:border-box}.hero{display:flex;align-items:center;margin-bottom:24rpx}.hero-icon{width:88rpx;height:88rpx;border-radius:28rpx;background:#FFE6D8;display:flex;align-items:center;justify-content:center;font-size:48rpx;margin-right:20rpx}.hero-title{font-size:40rpx;font-weight:800;color:#2F2925}.hero-sub{font-size:24rpx;color:#9A9088;margin-top:8rpx}.card{background:#FFFDF9;border-radius:28rpx;padding:28rpx;box-sizing:border-box;box-shadow:0 10rpx 32rpx rgba(85,57,35,.06);margin-bottom:22rpx}.dish-card{display:flex;align-items:center}.dish-icon{width:76rpx;height:76rpx;border-radius:22rpx;background:#FFF0E5;display:flex;align-items:center;justify-content:center;font-size:40rpx;margin-right:18rpx}.dish-info{flex:1;min-width:0}.dish-name{font-size:32rpx;font-weight:700;color:#302923}.muted{font-size:24rpx;color:#9A9088;margin-top:6rpx}.price{font-size:28rpx;font-weight:800;color:#FF6848;white-space:nowrap}.section-title{font-size:30rpx;font-weight:800;color:#302923;margin-bottom:22rpx}.label{font-size:24rpx;color:#766C64;margin:18rpx 0 10rpx}.form input{height:84rpx;background:#F9F5EF;border-radius:18rpx;padding:0 22rpx;box-sizing:border-box;font-size:28rpx;color:#302923}.datetime{display:flex;gap:18rpx}.picker{height:84rpx;line-height:84rpx;background:#F9F5EF;border-radius:18rpx;padding:0 22rpx;font-size:28rpx;color:#302923;min-width:250rpx}.tips{margin-top:22rpx;padding:20rpx;border-radius:18rpx;background:#FFF4E9;color:#8D796B;font-size:23rpx;line-height:1.6}.primary{background:#FF6848;color:#fff;border:0;border-radius:999rpx;font-weight:700}.create-btn{height:92rpx;line-height:92rpx;font-size:30rpx;margin-top:12rpx}.safe-tip{text-align:center;color:#A59B93;font-size:22rpx;margin-top:18rpx}button::after{border:0}