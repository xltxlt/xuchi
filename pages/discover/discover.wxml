<view class="page">
  <view class="hero">
    <view class="eyebrow">发现今天的好吃</view>
    <view class="title">同好都在吃什么？</view>
    <view class="sub">不是全网最火，而是更像你的人正在许吃</view>
    <view class="hobby-entry" bindtap="openHobby"><view><text class="entry-title">👯 找口味同好</text><text class="entry-sub">看看和你最像的人</text></view><text>›</text></view>
  </view>
  <view class="section-title">热门口味</view>
  <scroll-view scroll-x class="tag-scroll">
    <view wx:for="{{hotTags}}" wx:key="*this" class="hot-tag" data-tag="{{item}}" bindtap="chooseTag">{{item}}</view>
  </scroll-view>
  <view class="section-title feed-title">正在发生</view>
  <view wx:for="{{feed}}" wx:key="_id" class="feed-card">
    <view class="feed-head"><text class="avatar">{{item.avatar||'🍜'}}</text><view class="person"><text class="person-name">{{item.userName||item.authorName||item.name||'美食同好'}}</text><text class="person-time">{{item.time||'刚刚'}}</text></view><text class="match" wx:if="{{item.match}}">{{item.match}}%像你</text></view>
    <view class="feed-text">{{item.text||item.note||'分享了一道美食'}}</view>
    <image wx:if="{{item.image}}" class="feed-image" src="{{item.image}}" mode="aspectFill" lazy-load="true"/>
    <view class="dish-row" wx:if="{{item.dishId||item.dishName||item.name}}" data-id="{{item.dishId}}" bindtap="openDish"><text class="dish-icon">🍽️</text><view><text class="dish-name">{{item.dishName||item.dish||item.name}}</text><text class="dish-store">{{item.store||'本地好店'}}</text></view><text class="arrow">›</text></view>
    <view class="feed-tags" wx:if="{{item.tags&&item.tags.length}}"><text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text></view>
  </view>
  <view wx:if="{{!loading && !feed.length}}" class="empty">还没有动态，去发布你的第一口吧～<button size="mini" bindtap="publish">去发布</button></view>
</view>