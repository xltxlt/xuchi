.page{min-height:100vh;background:#fff8ef;padding:28rpx;box-sizing:border-box}.hero{padding:22rpx 8rpx 30rpx}.title{font-size:46rpx;font-weight:700;color:#302923}.sub{font-size:26rpx;color:#8d8279;line-height:1.6;margin-top:12rpx}.card{background:#fffdf9;border-radius:28rpx;padding:28rpx;margin-bottom:22rpx;box-shadow:0 8rpx 30rpx rgba(70,45,25,.06)}.section-title{font-size:32rpx;font-weight:700;color:#332b26}.outside{margin:34rpx 4rpx 20rpx}.form input{height:82rpx;border-bottom:1rpx solid #eee4da;font-size:28rpx}.row{display:flex;gap:18rpx}.half{flex:1}.primary{margin-top:26rpx;background:#ff6848;color:#fff;border-radius:44rpx;font-size:30rpx}.group-title{font-size:32rpx;font-weight:700}.muted{font-size:25rpx;color:#93877d;margin-top:10rpx}.stats{display:flex;justify-content:space-between;margin-top:24rpx;color:#8b7e74;font-size:24rpx}.num{font-size:34rpx;color:#ff6848;font-weight:700}.empty{text-align:center;color:#aaa;padding:90rpx 0}