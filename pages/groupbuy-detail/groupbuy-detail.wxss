.page{min-height:100vh;background:#fff8ef;padding:28rpx;box-sizing:border-box}.card{background:#fffdf9;border-radius:28rpx;padding:30rpx;margin-bottom:22rpx;box-shadow:0 8rpx 30rpx rgba(70,45,25,.06)}.title{font-size:40rpx;font-weight:700;color:#302923}.muted{font-size:24rpx;color:#948980;line-height:1.6}.price{font-size:34rpx;color:#ff6848;font-weight:700;margin-top:18rpx}.summary{display:flex;background:#fff0e7;border-radius:24rpx;padding:28rpx 10rpx;margin-bottom:22rpx;text-align:center;color:#95877e}.summary>view{flex:1;font-size:23rpx}.big{font-size:38rpx;font-weight:700;color:#ff6848}.section-title{font-size:31rpx;font-weight:700;margin-bottom:18rpx}.form input{height:80rpx;border-bottom:1rpx solid #eee4da;font-size:28rpx}.primary{margin-top:24rpx;background:#ff6848;color:#fff;border-radius:44rpx}.ghost,.close{margin-top:16rpx;border-radius:44rpx;background:#fff;color:#ff6848;border:1rpx solid #ffb39f}.member{display:flex;justify-content:space-between;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #f0e8e1}.name{font-size:29rpx;font-weight:600}.owner{font-size:20rpx;color:#ff6848;background:#fff0e7;padding:6rpx 10rpx;border-radius:12rpx}.member-qty{font-size:30rpx;font-weight:700;color:#ff6848}.close{width:100%;margin-bottom:40rpx}