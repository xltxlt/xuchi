<view class="page" wx:if="{{group}}">
  <view class="card head"><view class="title">{{group.title}}</view><view class="muted">{{group.dishName}} {{group.storeName ? '· '+group.storeName : ''}}</view><view class="price">¥{{group.price || 0}} / {{group.unit || '份'}}</view></view>
  <view class="summary"><view><text class="big">{{group.totalQty || 0}}</text><text> {{group.unit || '份'}}</text><view>总数量</view></view><view><text class="big">{{group.participantCount || 0}}</text><text> 人</text><view>已参与</view></view><view><text class="big">¥{{(group.price || 0) * (group.totalQty || 0)}}</text><view>预计金额</view></view></view>
  <view class="card form"><view class="section-title">我要买多少？</view><input type="number" value="{{qty}}" data-key="qty" bindinput="changeQty" /><input placeholder="你的名字" value="{{name}}" data-key="name" bindinput="input" /><input placeholder="备注（口味/规格等，可选）" value="{{note}}" data-key="note" bindinput="input" /><button class="primary" bindtap="join">{{group.mine ? '更新我的数量' : '加入团购'}}</button><button wx:if="{{group.mine && group.mine.qty}}" class="ghost" bindtap="leave">移除我的数量</button></view>
  <view class="card"><view class="section-title">人员明细</view><view wx:for="{{group.members}}" wx:key="_id" class="member"><view><text class="name">{{item.name}}</text><text wx:if="{{item.role==='owner'}}" class="owner"> 发起人</text><view class="muted">{{item.note || '—'}}</view></view><view class="member-qty">{{item.qty || 0}} {{group.unit || '份'}}</view></view></view>
  <button wx:if="{{group.creatorId === group.mine?.openid}}" class="close" bindtap="close">结束团购</button>
</view>